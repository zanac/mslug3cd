index a23574b..2cd5466 100644
--- a/src/cpu/m68000/m68kcpu.c
+++ b/src/cpu/m68000/m68kcpu.c
@@ -641,6 +641,7 @@ void m68k_set_cpu_type(unsigned int cpu_type)
 
 /* Execute some instructions until we use up num_cycles clock cycles */
 /* ASG: removed per-instruction interrupt checks */
+unsigned char dev_site[0x80000]; unsigned dev_neutral_lo, dev_neutral_hi; int dev_neutral_on; static int dev_cycles_before;
 int m68k_execute(int num_cycles)
 {
 	/* Make sure we're not stopped */
@@ -673,9 +674,17 @@ int m68k_execute(int num_cycles)
 			REG_PPC = REG_PC;
 
 			/* Read an instruction and call its handler */
+			dev_cycles_before = GET_CYCLES();
 			REG_IR = m68ki_read_imm_16();
 			m68ki_instruction_jump_table[REG_IR]();
 			USE_CYCLES(CYC_INSTRUCTION[REG_IR]);
+			if (dev_neutral_on)
+			{
+				/* dev: the patched sprite blocks cost what the original block did (48 cycles) */
+				unsigned ppc = REG_PPC & 0xffffff;
+				if (ppc >= dev_neutral_lo && ppc < dev_neutral_hi) SET_CYCLES(dev_cycles_before);
+				else if (ppc < 0x100000 && dev_site[ppc >> 1]) SET_CYCLES(dev_site[ppc >> 1] == 1 ? dev_cycles_before - 48 : dev_cycles_before);
+			}
 
 			/* Trace m68k_exception, if necessary */
 			m68ki_exception_if_trace(); /* auto-disable (see m68kcpu.h) */
diff --git a/src/cpu/m68000/m68kmame.h b/src/cpu/m68000/m68kmame.h
index d609f98..6c76f53 100644
--- a/src/cpu/m68000/m68kmame.h
+++ b/src/cpu/m68000/m68kmame.h
@@ -51,9 +51,26 @@
 
 extern struct m68k_memory_interface m68k_memory_intf;
 
-#define m68k_read_memory_8(address)          (*m68k_memory_intf.read8)(address)
-#define m68k_read_memory_16(address)         (*m68k_memory_intf.read16)(address)
-#define m68k_read_memory_32(address)         (*m68k_memory_intf.read32)(address)
+/* dev (Metal Slug 3 study): the 256-byte pages of the Neo Geo program ROM the 68000 reads or executes */
+extern unsigned char ms3_touch_map[0x9000];
+extern unsigned char ms3_window_seen[4096][0x9000 / 8];   /* [page of the window][physical page] */
+extern unsigned ms3_bank_base;
+static INLINE void ms3_touch(unsigned int address)
+{
+	address &= 0xffffff;
+	if (address < 0x100000)
+		ms3_touch_map[address >> 8] = 1;
+	else if (address - 0x200000 < 0x100000)
+	{
+		unsigned window_page = (address - 0x200000) >> 8, page = (ms3_bank_base + (address - 0x200000)) >> 8;
+		ms3_touch_map[page] = 1;
+		ms3_window_seen[window_page][page >> 3] |= 1 << (page & 7);
+	}
+}
+
+#define m68k_read_memory_8(address)          (ms3_touch(address), (*m68k_memory_intf.read8)(address))
+#define m68k_read_memory_16(address)         (ms3_touch(address), (*m68k_memory_intf.read16)(address))
+#define m68k_read_memory_32(address)         (ms3_touch(address), (*m68k_memory_intf.read32)(address))
 
 #define m68k_read_immediate_16(address)      m68kx_read_immediate_16(address)
 #define m68k_read_immediate_32(address)      m68kx_read_immediate_32(address)
@@ -80,6 +97,7 @@ static INLINE void m68k_write_memory_32_pd(unsigned int address, unsigned int va
 
 static INLINE unsigned int m68kx_read_immediate_16(unsigned int address)
 {
+	ms3_touch(address);
 	return cpu_readop16((address) ^ m68k_memory_intf.opcode_xor);
 }
 
