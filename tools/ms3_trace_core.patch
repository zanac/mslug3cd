+/* dev: the bank switches: pc | bank number << 24 */
+static unsigned dev_bank_log[1024];
+static int dev_bank_count;
+__attribute__((visibility("default"))) int retro_dev_banks_take(unsigned *buffer, int maximum)
+{
+	int count = dev_bank_count < 1024 ? dev_bank_count : 1024, i;
+	for (i = 0; i < count && i < maximum; i++) buffer[i] = dev_bank_log[i];
+	dev_bank_count = 0;
+	return count < maximum ? count : maximum;
+}
+
 static WRITE16_HANDLER( mslug3_bankswitch_w )
 {
 	/* thanks to Razoola and Mr K for the info */
@@ -1886,6 +1897,7 @@ static WRITE16_HANDLER( mslug3_bankswitch_w )
 		(((data>> 9)&1)<<5);
 
 	bankaddress = 0x100000 + bankoffset[data];
+	dev_bank_log[dev_bank_count++ & 1023] = (cpunum_get_reg(0, REG_PC) & 0xffffff) | ((unsigned)data << 24);
 
 	neogeo_set_cpu1_second_bank(bankaddress);
 }
