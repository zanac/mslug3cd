 /* ADPCM type A Write */
+/* dev: ADPCM-A samples started (start, end) since the last retro_dev_adpcm_take() */
+static unsigned dev_adpcm_log[8192][2];
+static int dev_adpcm_count;
+__attribute__((visibility("default"))) int retro_dev_adpcm_take(unsigned *buffer, int maximum)
+{
+	int count = dev_adpcm_count < 8192 ? dev_adpcm_count : 8192, i;
+	for (i = 0; i < count && i < maximum; i++) { buffer[2*i] = dev_adpcm_log[i][0]; buffer[2*i+1] = dev_adpcm_log[i][1]; }
+	dev_adpcm_count = 0;
+	return count < maximum ? count : maximum;
+}
