+/* dev: list (and forget) the tile numbers drawn since the last call; returns how many */
+__attribute__((visibility("default"))) int retro_dev_tiles_take(unsigned *ids, int maximum)
+{
+	int count = 0, tile;
+	for (tile = 0; tile < 0x80000; tile++)
+		if (dev_tile_used[tile])
+		{
+			dev_tile_used[tile] = 0;
+			if (count < maximum) ids[count] = tile;
+			count++;
+		}
+	return count;
+}
