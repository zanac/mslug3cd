 	/* spin for a while to let the Z80 read the command (fixes hanging sound in pspikes2) */
@@ -8067,10 +8083,60 @@ DRIVER_INIT( kf2k3upl )
 
 static UINT32 cpu1_second_bankaddress;
 
+/* dev (Metal Slug 3 study): see m68kmame.h */
+unsigned char ms3_touch_map[0x9000];
+unsigned char ms3_window_seen[4096][0x9000 / 8];
+unsigned ms3_bank_base;
+/* dev: patch the decrypted 68000 program in place (address as the 68000 sees it in the fixed region) */
+__attribute__((visibility("default"))) void retro_dev_patch(unsigned address, unsigned length, const unsigned char *bytes)
+{
+	unsigned i; unsigned char *RAM = memory_region(REGION_CPU1);
+	extern unsigned char dev_site[0x80000]; extern unsigned dev_neutral_lo, dev_neutral_hi; extern int dev_neutral_on;
+	for (i = 0; i < length; i++) RAM[(address + i) ^ 1] = bytes[i];
+	if (length == 10 && bytes[0] == 0x4e && bytes[1] == 0xb9) { dev_site[address >> 1] = 1; dev_site[(address >> 1) + 3] = 2; dev_site[(address >> 1) + 4] = 2; dev_neutral_on = 1; }
+	else if (length > 10 && address >= 0xfa000) { dev_neutral_lo = address; dev_neutral_hi = address + length; }
+}
+/* dev: a byte of the 68000 program region (decrypted), at the physical offset the bank switch uses */
+__attribute__((visibility("default"))) unsigned retro_dev_program_byte(unsigned offset)
+{
+	return offset < memory_region_length(REGION_CPU1) ? memory_region(REGION_CPU1)[offset] : 0;
+}
+/* (window page, physical page) pairs seen since the last reset; returns how many */
+__attribute__((visibility("default"))) int retro_dev_window_pairs(unsigned *pairs, int maximum)
+{
+	int count = 0, window_page, page;
+	for (window_page = 0; window_page < 4096; window_page++)
+		for (page = 0; page < 0x9000; page++)
+			if (ms3_window_seen[window_page][page >> 3] & (1 << (page & 7)))
+			{
+				if (count < maximum) { pairs[2 * count] = window_page; pairs[2 * count + 1] = page; }
+				count++;
+			}
+	return count;
+}
+__attribute__((visibility("default"))) void retro_dev_window_reset(void)
+{
+	memset(ms3_window_seen, 0, sizeof ms3_window_seen);
+}
+__attribute__((visibility("default"))) int retro_dev_touch_take(unsigned *pages, int maximum)
+{
+	int count = 0, page;
+	for (page = 0; page < 0x9000; page++)
+		if (ms3_touch_map[page])
+		{
+			ms3_touch_map[page] = 0;
+			if (count < maximum) pages[count] = page;
+			count++;
+		}
+	return count;
+}
+
 void neogeo_set_cpu1_second_bank(UINT32 bankaddress)
 {
 	data8_t *RAM = memory_region(REGION_CPU1);
 
+	ms3_bank_base = bankaddress;
+
 	cpu1_second_bankaddress = bankaddress;
 	cpu_setbank(4,&RAM[bankaddress]);
 }
